{
  "name": "cahier-ecriture",
  "productName": "Cahier d'écriture",
  "version": "1.1.1",
  "description": "Feuilles d'exercices à imprimer pour apprendre à écrire et à calculer : écriture cursive sur réglure Seyès, opérations à trou.",
  "main": "main.js",
  "author": {
    "name": "Yoann Saunier",
    "email": "yoann@ysaunier.dev",
    "url": "https://github.com/ysaunier"
  },
  "homepage": "https://github.com/ysaunier/cahier-ecriture",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysaunier/cahier-ecriture.git"
  },
  "bugs": {
    "url": "https://github.com/ysaunier/cahier-ecriture/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:mac": "electron-builder --mac",
    "lint": "eslint .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:smoke": "electron test/smoke/smoke.js",
    "check": "npm run lint && npm test && npm run test:smoke",
    "release-notes": "node scripts/release-notes.js"
  },
  "build": {
    "appId": "local.cahier-ecriture",
    "productName": "Cahier d'écriture",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**",
      "fonts/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Cahier-ecriture-portable.exe",
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "artifactName": "Cahier-ecriture-installation.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cahier d'écriture",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Cahier-ecriture-mac.${ext}"
    },
    "dmg": {
      "title": "Cahier d'écriture",
      "artifactName": "Cahier-ecriture-mac.${ext}"
    },
    "copyright": "© 2026 Yoann Saunier"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/ysaunier"
  }
}
